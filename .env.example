# =============================================================================
# ClearNote_Dev — Plantilla de Variables de Entorno (.env.example)
# =============================================================================
# INSTRUCCIONES: 
# 1. Copiar a .env 
# 2. Modificar SOLO las secciones marcadas como [ PROYECTO NUEVO ]
# =============================================================================

# --- ENTORNO [ PROYECTO NUEVO ] ---
# APP_ENV = INTERRUPTOR MAESTRO: 'development' (default) o 'production'.
# De él se derivan: la ruta por defecto del secreto de la DB (connection.py,
# run-admin.sh) y el modo de los scripts (init.sh solo corre en dev). 'prod'/
# 'production' → prod; cualquier otra cosa → dev.
APP_ENV=development
APP_NAME=mi-nuevo-proyecto      # <--- Nombre de la solución/cliente
LOG_LEVEL=INFO
DEBUG=True

# --- PYTHON (Estático) ---
# Mantiene src/ visible para importaciones entre módulos
PYTHONPATH=${PYTHONPATH}:..

# --- BASE DE DATOS [ PROYECTO NUEVO ] ---
DB_HOST=db
DB_PORT=5432
DB_NAME=db_nombre_proyecto      # <--- Nombre de la DB física
DB_USER=admin_proyecto          # <--- Usuario con privilegios en la DB

# Contraseña: SIEMPRE por archivo de secreto. La ruta por DEFECTO la deriva APP_ENV:
#   development -> ./secrets/db_password.txt   (repo, gitignored)
#   production  -> /run/secrets/db_password    (lo monta el orquestador/vault)
# Descomenta SOLO para forzar una ruta distinta al default de APP_ENV:
# DB_PASSWORD_FILE=./secrets/db_password.txt

# URL de Conexión: el código la ARMA solo (piezas + secreto, vía connection.py)
# mientras contenga el placeholder. Déjala así salvo que una herramienta externa
# necesite leerla literal (entonces rellena la contraseña real).
DATABASE_URL=postgresql://${DB_USER}:PASSWORD_HERE@${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- BASE DE DATOS (TimescaleDB) ---
# Descomentar solo si el servicio timescaledb está activo en docker-compose
# TIMESCALE_HOST=db
# TIMESCALE_PORT=5432

# --- SEGURIDAD [ PROYECTO NUEVO ] ---
# Secreto: Crear archivo en ./secrets/app_secret_key.txt
SECRET_KEY_FILE=./secrets/app_secret_key.txt

# --- CAPACIDADES IA [ PROYECTO NUEVO ] ---
# Descomentar si el proyecto incluye funcionalidades de IA
# AI_PROVIDER=openai            # <--- openai | anthropic | abacus
# AI_MODEL=gpt-4o               # <--- Modelo principal a consumir
# AI_API_KEY_FILE=./secrets/ai_api_key.txt